<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The <queries> element lets the app ask the package manager about the
  installation status of the text-to-speech engine (Android 11+ package
  visibility). -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
  </queries>

  <!-- The TalkBackApplication class lived in the :talkback module, which is
  not part of the AnTTS build, so no custom Application class is declared. -->
  <application
     android:enableOnBackInvokedCallback="true" />

</manifest>
